# Beetbox Configuration

# Path to your music library (mounted in container as /music)
MUSIC_PATH=/path/to/your/music

# Path to beets database (mounted in container as /data)
BEETS_DB_PATH=/path/to/beets/library.db

# API Configuration
HOST=0.0.0.0
PORT=8337

# Security
READONLY=true
INCLUDE_PATHS=false

# CORS (set to specific origin in production)
CORS_ORIGIN=*
